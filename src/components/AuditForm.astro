<section class="panel audit-panel" aria-labelledby="audit-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">01 · Audit</p>
      <h2 id="audit-heading">Start with one public page</h2>
    </div>
    <div class="status-stack" aria-label="Runtime status">
      <span id="mode-status" class="status-pill">No audit yet</span>
      <span id="webmcp-status" class="status-pill status-pill-muted" aria-live="polite">WebMCP registration pending</span>
    </div>
  </div>

  <form id="auvrora-audit-form" class="audit-form">
    <label for="auvrora-url">Public page URL</label>
    <div class="audit-input-row">
      <input
        id="auvrora-url"
        name="url"
        type="url"
        inputmode="url"
        autocomplete="url"
        placeholder="https://example.com/page"
        maxlength="2048"
        required
      />
      <button id="auvrora-run" class="button button-primary" type="submit">Run audit</button>
      <button id="auvrora-demo" class="button button-secondary" type="button">Try demo</button>
    </div>
    <p class="field-note">One bounded HTML request. No login, cookies, JavaScript execution, or private-network targets.</p>
  </form>
</section>
