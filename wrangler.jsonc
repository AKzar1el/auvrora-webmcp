{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loopfix-webmcp",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "AUDIT_RATE_LIMITER",
      "namespace_id": "1350029220",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
