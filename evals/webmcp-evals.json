[
  {
    "name": "[direct] audit a public page",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Audit https://example.com/ with LoopFix."
      }
    ],
    "expectedCall": [
      {
        "functionName": "run_audit",
        "arguments": { "url": "https://example.com/" }
      }
    ]
  },
  {
    "name": "[direct] audit then list findings",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Check https://example.com/ and show me the audit findings."
      }
    ],
    "expectedCall": [
      {
        "functionName": "run_audit",
        "arguments": { "url": "https://example.com/" },
        "mockOutput": {
          "canonicalUrl": "https://example.com/",
          "totalFindings": 3,
          "counts": { "error": 1, "warning": 1, "notice": 1 },
          "next": "Use list_findings to inspect the bounded results."
        }
      },
      {
        "functionName": "list_findings",
        "arguments": { "limit": 10 }
      }
    ]
  },
  {
    "name": "[direct] inspect the missing meta description",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Audit https://example.com/, find the missing meta description issue, and inspect its evidence and recommended action."
      }
    ],
    "expectedCall": [
      {
        "functionName": "run_audit",
        "arguments": { "url": "https://example.com/" },
        "mockOutput": {
          "canonicalUrl": "https://example.com/",
          "totalFindings": 3,
          "counts": { "error": 1, "warning": 1, "notice": 1 }
        }
      },
      {
        "functionName": "list_findings",
        "arguments": { "limit": 10 },
        "mockOutput": {
          "findings": [
            {
              "id": "finding:missing_meta_description",
              "severity": "error",
              "code": "missing_meta_description",
              "title": "Missing meta description",
              "affectedUrl": "https://example.com/",
              "selected": false
            },
            {
              "id": "finding:title_too_short",
              "severity": "warning",
              "code": "title_too_short",
              "title": "Page title is very short",
              "affectedUrl": "https://example.com/",
              "selected": false
            },
            {
              "id": "finding:missing_canonical",
              "severity": "notice",
              "code": "missing_canonical",
              "title": "No canonical link",
              "affectedUrl": "https://example.com/",
              "selected": false
            }
          ],
          "returned": 3,
          "available": 3,
          "truncated": false
        }
      },
      {
        "functionName": "inspect_finding",
        "arguments": { "findingId": "finding:missing_meta_description" }
      }
    ]
  },
